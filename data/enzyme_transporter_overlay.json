{
  "_meta": {
    "purpose": "Adds enzyme + transporter data (with actions) on top of rag/processed/drugs.json, which ships with 0% coverage for both fields.",
    "why_an_overlay": "rag/processed/ is gitignored and has no generator script in this repo, so it cannot be regenerated. This file lives in data/ so it IS version-controlled, and is merged onto drugs.json at load time by rag/graph.py::load_drugs().",
    "schema": {
      "drugs": {
        "<drugbank_id>": {
          "name": "human-readable name, for sanity checking only",
          "enzymes": [{"name": "CYP2C9", "actions": ["substrate|inhibitor|inducer"]}],
          "transporters": [{"name": "ABCB1", "actions": ["substrate|inhibitor|inducer"]}]
        }
      }
    },
    "source": "HAND-CURATED DEMO SEED -- textbook pharmacology only, NOT a DrugBank export.",
    "WARNING": "This seed exists so the mechanistic-inference code path can be exercised and tested. It covers ~13 drugs. It is NOT a clinical dataset and MUST be replaced by a real DrugBank/PharmGKB export before any clinical use. Provenance is propagated into the mechanism report so the LLM and the pharmacist can see it.",
    "replace_with": "DrugBank full XML release (academic licence) -- its <enzymes>/<transporters> elements carry exactly these action arrays and join on the drug_id already used here."
  },

